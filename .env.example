# PRODUCTION (default)
VITE_WS_API_URL=https://app.nurcrm.kg
# VITE_API_URL unset → https://app.nurcrm.kg/api

# LOCAL DEV — create .env.local:
# DEV_BACKEND=http://localhost:8000
# VITE_API_URL=/api
# VITE_WS_API_URL=

# Optional register gate (no default password in code — set explicitly)
# VITE_REGISTER_ACCESS_PASSWORD=your-secret
# VITE_REGISTER_ACCESS_BACKEND=false

# Optional building handoff
# VITE_BUILDING_APP_URL=https://stroy.nurcrm.kg
# VITE_MAIN_APP_URL=https://app.nurcrm.kg

# Auto-cashflows на бэке (docs/backend/kassa/auto-cashflows-backend.md)
# "true" → BE создаёт income/expense внутри бизнес-эндпоинтов, FE не постит
# /construction/cashflows/ после операций. ВКЛЮЧАТЬ СИНХРОННО с BE AUTO_CASHFLOWS
# в окне релиза 2026-09-10 04:00–06:00 UTC+6 (см. docs/backend/kassa/RELEASE-2026-09-10.md).
# Раньше/позже BE → double-write или деньги мимо учёта.
# VITE_BE_CASHFLOWS=true

# Cashflow edit/cancel requests (docs/backend/kassa/cashflow-edit-cancel-request-backend.md)
# Staging — включать сейчас. Прод — ТОЛЬКО после выката BE 2026-09-10
# (до этого эндпоинтов /edit-request/, /cancel-request/ в проде нет).
# VITE_CASHFLOW_CHANGE_REQUESTS=true

# Удаление кассы прочих расходов (docs/backend/kassa/cashbox-delete-backend.md)
# Кнопка «Удалить» (+ наследование отчёта в другую кассу, массовое удаление)
# в списке /crm/kassa для касс расходов (owner/admin).
# Включать только после выката BE DELETE /construction/cashboxes/{id}/.
# VITE_CASHBOX_DELETE=true

# Роль кассы «Для долгов» (docs/backend/kassa/cashbox-debt-role-backend.md)
# Чекбокс «Для долгов» при создании кассы + действие «Назначить кассой для
# долгов» на существующей (owner/admin). Требует явного role в POST/PATCH
# /construction/cashboxes/ на бэке — пока не реализовано, включать нельзя.
# VITE_CASHBOX_DEBT_ROLE=true

# Срок годности по партиям прихода (FEFO) вместо одной даты на товаре
# (docs/backend/product-batch-expiry-backend.md). Форма товара просит
# длительность хранения (дни/месяцы); каждый приход создаёт партию со своим
# expires_at. Включать только после выката BE-модели партий + эндпоинтов.
# VITE_PRODUCT_BATCH_EXPIRY=true

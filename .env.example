# PRODUCTION (default)
VITE_WS_API_URL=https://app.nurcrm.kg
# VITE_API_URL unset → https://app.nurcrm.kg/api

# LOCAL DEV — create .env.local:
# DEV_BACKEND=http://localhost:8000
# VITE_API_URL=/api
# VITE_WS_API_URL=

# Optional register gate (no default password in code — set explicitly)
# VITE_REGISTER_ACCESS_PASSWORD=your-secret
# VITE_REGISTER_ACCESS_BACKEND=false

# Optional building handoff
# VITE_BUILDING_APP_URL=https://stroy.nurcrm.kg
# VITE_MAIN_APP_URL=https://app.nurcrm.kg

# Cashflow edit/cancel requests (docs/backend/kassa/cashflow-edit-cancel-request-backend.md)
# BE готов только на Staging (2026-09-04) — включать ТОЛЬКО в staging-сборке,
# не в прод-билде (в проде эндпоинтов ещё нет).
# VITE_CASHFLOW_CHANGE_REQUESTS=true
